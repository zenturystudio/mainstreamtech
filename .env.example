NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# Pooler (IPv4) connection string, used only by `npm run db:types`
SUPABASE_DB_URL=
# Admin CMS origin in local dev (admin runs as a second dev server). Leave empty in production.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# Image CDN domain (an extra domain on this same Vercel project). Leave empty until
# it resolves, or all images break. e.g. https://cdn.mainstreamtech.co.uk
NEXT_PUBLIC_IMAGE_CDN_URL=
# Clomark receiver (/api/content). Long random secret; Clomark sends it in the x-api-key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, the endpoints refuse every request.
CLOMARK_API_KEY=
# true = honour Clomark's status "published" (goes live immediately). Anything else = drafts for review.
CLOMARK_AUTO_PUBLISH=false
# Category (slug) for new Clomark posts, which arrive without one. Default: technology
CLOMARK_DEFAULT_CATEGORY=technology
